#!/bin/bash
set -eu -o pipefail
[ ! -d /etc/zfs/zed.d ] && return 1
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
[ -e /etc/zfs/zed.d/history_event-zfs-list-cacher.sh ] && sudo rm -f /etc/zfs/zed.d/history_event-zfs-list-cacher.sh
sudo cp "${SCRIPT_DIR}/history_event-zfs-list-mount-cacher.sh" /etc/zfs/zed.d/

# ensure zfs mount --all does not run druing init
[ ! "$(systemctl is-enabled zfs-mount.service)" = "masked" ] && sudo systemctl mask zfs-mount.service
